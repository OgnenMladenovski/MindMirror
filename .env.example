# ─────────────────────────────────────────────────────────────
# MindMirror — environment configuration
# Copy to `.env` (used automatically by docker compose) and adjust.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=mindmirror
POSTGRES_USER=mindmirror
POSTGRES_PASSWORD=mindmirror_dev_pw
POSTGRES_PORT=5432

# Spring Boot backend
BACKEND_PORT=8080
# HMAC-SHA256 secret for signing JWTs. MUST be >= 32 chars. Change in production.
JWT_SECRET=change-me-mindmirror-super-secret-key-please-rotate-in-prod
JWT_EXPIRATION_MS=86400000

# FastAPI AI microservice
AI_SERVICE_PORT=8000
# URL the backend uses to reach the AI service (container DNS name inside compose).
AI_SERVICE_URL=http://ai-service:8000

# Seed a demo student (email demo@mindmirror.app / password demo1234) with ~30 days of logs.
SEED_DEMO_DATA=true
